# ========== QUIETSPACE ENVIRONMENT VARIABLES ==========
# Ushbu fayldan nusxa olib, .env yarating va haqiqiy qiymatlarni kiriting:
#   cp .env.example .env
# .env HECH QACHON GitHub'ga push qilinmasligi kerak!

# ========== DJANGO / ASOSIY ==========
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ========== DATABASE ==========
DATABASE_NAME=your_database
DATABASE_USER=your_user
DATABASE_PASSWORD=your_password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# ========== TELEGRAM BOT ==========
TELEGRAM_BOT_TOKEN=your-bot-token
# Bot backend API'ga shu manzil orqali murojaat qiladi
BACKEND_URL=http://127.0.0.1:8000

# ========== AI ==========
AI_API_KEY=your-ai-api-key
# AI_API_KEY bo'sh bo'lsa offline (rule-based) rejim ishlaydi
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Gemini (Google) - o'rnatilgan bo'lsa OpenAI o'rniga ishlaydi
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# ========== CORS (production) ==========
# CORS_ALLOW_ALL_ORIGINS=true  # demo uchun hamma origin ruxsat
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ========== FRONTEND ==========
FRONTEND_URL=http://localhost:5173

# ========== JWT / AUTH ==========
JWT_SECRET=your-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60